# El Dockerfile solo usa estos archivos del contexto local. Esta allowlist evita
# enviar bases de datos, datos de Nextcloud, certificados, secretos y .git al daemon.
**
!Dockerfile
!supervisord.conf
!.dockerignore

# Configuración PHP-FPM incluida explícitamente en la imagen derivada.
!config/
config/**
!config/php-fpm/
!config/php-fpm/zz-nextcloud.conf
