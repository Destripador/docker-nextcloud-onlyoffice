# Identidad del proyecto. Cambiarla crea un proyecto Compose distinto.
COMPOSE_PROJECT_NAME=nextcloud
# Active ACME para el ejemplo HTTPS. Déjelo vacío si termina TLS externamente.
COMPOSE_PROFILES=acme

# Referencias explícitas revisadas el 2026-09-07. Puede usar tags o digests,
# pero no deje valores vacíos ni use latest en producción.
NEXTCLOUD_BASE_IMAGE=nextcloud:34.0.3-fpm-alpine
NEXTCLOUD_APP_IMAGE=nextcloud-onlyoffice-app:34.0.3
MARIADB_IMAGE=mariadb:11.8.9
REDIS_IMAGE=redis:7.4.11-alpine
NGINX_IMAGE=nginx:1.30.4-alpine
NGINX_PROXY_IMAGE=nginxproxy/nginx-proxy:1.11.6
ACME_COMPANION_IMAGE=nginxproxy/acme-companion:2.8.2
ONLYOFFICE_IMAGE=onlyoffice/documentserver:9.4.0.1

# Dominio y proxy. Para HTTP local, use http y no active el perfil acme.
NEXTCLOUD_DOMAIN=cloud.example.com
NEXTCLOUD_TRUSTED_DOMAINS=cloud.example.com
NEXTCLOUD_OVERWRITE_PROTOCOL=https
NEXTCLOUD_OVERWRITE_HOST=cloud.example.com
NEXTCLOUD_PUBLIC_URL=https://cloud.example.com
NGINX_PROXY_NETWORK=nginx-proxy
PROXY_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
ACME_EMAIL=admin@example.com

# Base de datos y cuenta inicial. Los secretos vacíos hacen fallar Compose hasta
# que se sustituyan por valores propios.
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=

# Secretos compartidos. Use valores aleatorios diferentes entre sí.
REDIS_PASSWORD=
ONLYOFFICE_JWT_SECRET=

# Límites y zona horaria. PHP_UPLOAD_LIMIT debe coincidir con ambos Nginx.
PHP_MEMORY_LIMIT=1024M
PHP_UPLOAD_LIMIT=10G
TZ=UTC
